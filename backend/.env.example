# AirPurify AI - Environment Configuration

# MongoDB Atlas Connection
# Replace with your actual MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/airpurify_ai?retryWrites=true&w=majority
MONGODB_DB_NAME=airpurify_ai

# Server settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# AQI Standard Configuration (CPCB for India National Air Quality Index)
AQI_STANDARD=CPCB

# ML Model artifact paths
FORECASTING_MODEL_PATH=backend/app/ml_artifacts/cnn_bigru_forecast.pt
CLASSIFIER_MODEL_PATH=backend/app/ml_artifacts/indoor_outdoor_clf.joblib

# Fallback mode for development/testing if MongoDB Atlas is unreachable
FALLBACK_TO_MOCK_DB=true
